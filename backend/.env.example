# ============================================
# Extra Travel Point - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production), use:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Redis (optional but recommended for production)
REDIS_URL="redis://:REDIS_PASSWORD@REDIS_HOST:6379"
REDIS_PASSWORD=change-this-redis-password

# JWT Configuration (REQUIRED: generate strong random strings in production)
JWT_SECRET=change-this-to-a-very-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Payment Gateways (Test/Sandbox keys)
# bKash Sandbox Tokenized Checkout
PAYMENT_MODE=sandbox
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USER_NAME=your_bkash_sandbox_username
BKASH_PASSWORD=your_bkash_sandbox_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/bkash

# bKash Legacy/Stub (not used in sandbox mode)
BKASH_API_KEY=your_bkash_api_key
BKASH_SECRET_KEY=your_bkash_secret
BKASH_BASE_URL=https://checkout.sandbox.bka.sh

NAGAD_API_KEY=your_nagad_api_key
NAGAD_SECRET_KEY=your_nagad_secret
NAGAD_BASE_URL=https://sandbox.nagad.com

SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# Mock Payment Gateway (development/test only — never use in production)
# When PAYMENT_MODE=sandbox (or NODE_ENV=development), method='mock' is available
# for the frontend and tests. Mock payments auto-complete on initiation,
# allowing the full booking → payment → ticket flow to be tested without
# real gateway credentials. Set NODE_ENV=production to disable.
PAYMENT_MODE=sandbox
USE_MOCK_PAYMENT=true

# SMS/Notification
SMS_API_KEY=your_sms_api_key
FIREBASE_SERVER_KEY=your_firebase_server_key

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Storage Provider (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.)
# Set STORAGE_PROVIDER=mock for development/test without real storage.
STORAGE_PROVIDER=mock
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
STORAGE_UPLOAD_PREFIX=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Admin Default Credentials (DEV ONLY - change in production)
ADMIN_EMAIL=admin@extratravelpoint.com
ADMIN_PASSWORD=change-this-password

# Master Admin identification (server-side, never assignable via registration).
MASTER_ADMIN_EMAIL=superadmin@etp.demo
MASTER_ADMIN_PHONE=01710000001

# QR Security (REQUIRED: generate a strong secret in production)
QR_SECRET_KEY=change-this-qr-hmac-secret-in-production

# Webhook Security (REQUIRED: generate a strong secret in production)
WEBHOOK_SECRET=change-this-webhook-secret-in-production

# OmniRoute AI Gateway (local OmniRoute gateway for development).
# Set OMNIROUTE_API_KEY to the API key your local/remote OmniRoute instance requires.
# The provider sends it as `Authorization: Bearer <key>` to ${OMNIROUTE_BASE_URL}/chat/completions.
OMNIROUTE_API_KEY=your_omniroute_api_key
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto

# AI Provider Selection
# Set to "omniroute" (default, local development) or "gemini" (production fallback).
# When the local PC is off, set AI_PROVIDER=gemini so the app keeps working.
AI_PROVIDER=omniroute

# Google Gemini AI (used when AI_PROVIDER=gemini)
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Logging
LOG_LEVEL=info
