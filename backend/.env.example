# ============================================
# Extra Travel Point - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production), use:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# JWT Configuration (REQUIRED: generate strong random strings in production)
JWT_SECRET=change-this-to-a-very-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Payment Gateways (Test/Sandbox keys)
BKAASH_API_KEY=your_bkash_api_key
BKAASH_SECRET_KEY=your_bkash_secret
BKAASH_BASE_URL=https://checkout.sandbox.bka.sh

NAGAD_API_KEY=your_nagad_api_key
NAGAD_SECRET_KEY=your_nagad_secret

SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password

# SMS/Notification
SMS_API_KEY=your_sms_api_key
FIREBASE_SERVER_KEY=your_firebase_server_key

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Admin Default Credentials (DEV ONLY - change in production)
ADMIN_EMAIL=admin@extratravelpoint.com
ADMIN_PASSWORD=change-this-password

# Master Admin identification (server-side, never assignable via registration).
MASTER_ADMIN_EMAIL=superadmin@etp.demo
MASTER_ADMIN_PHONE=01710000001

# QR Security (REQUIRED: generate a strong secret in production)
QR_SECRET_KEY=change-this-qr-hmac-secret-in-production

# Webhook Security (REQUIRED: generate a strong secret in production)
WEBHOOK_SECRET=change-this-webhook-secret-in-production

# OmniRoute AI Gateway (optional - leave empty to disable AI)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=auto

# Logging
LOG_LEVEL=info
