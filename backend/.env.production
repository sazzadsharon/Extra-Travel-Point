# ============================================
# Extra Travel Point - Production Environment
# ============================================
# IMPORTANT: Change all default values before deploying!

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database (PostgreSQL)
DB_PROVIDER=postgresql
DATABASE_URL="postgresql://etp_user:etp_password_2026@etp-postgres:5432/etp_db?schema=public"

# Redis
REDIS_URL="redis://:etp_redis_pass@etp-redis:6379"
REDIS_PASSWORD=etp_redis_pass

# JWT - GENERATE STRONG SECRETS!
JWT_SECRET=CHANGE_THIS_TO_A_VERY_STRONG_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TOO_DIFFERENT_FROM_ABOVE
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Payment Gateways
BKAASH_API_KEY=your_bkash_live_key
BKAASH_SECRET_KEY=your_bkash_live_secret
NAGAD_API_KEY=your_nagad_live_key
NAGAD_SECRET_KEY=your_nagad_live_secret
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Admin
ADMIN_EMAIL=admin@extratravelpoint.com
ADMIN_PASSWORD=change_this_admin_password

# Database Credentials
DB_USER=etp_user
DB_PASSWORD=etp_password_2026
DB_NAME=etp_db

# Logging
LOG_LEVEL=info
