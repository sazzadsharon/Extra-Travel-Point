generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  phone            String            @unique
  email            String?           @unique
  fullName         String?
  passwordHash     String
  role             String            @default("customer")
  qrToken          String            @default(uuid())
  twoFactorEnabled Boolean           @default(false)
  twoFactorSecret  String?
  isActive         Boolean           @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookings         Booking[]
  qrLogs           QrLog[]
  reviews          Review[]
  seatLocks        SeatLock[]
  serviceProviders ServiceProvider[]
  sessions         Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       Int
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ServiceProvider {
  id              Int          @id @default(autoincrement())
  userId          Int
  businessName    String
  category        String
  description     String?
  address         String
  city            String?
  latitude        Float?
  longitude       Float?
  phone           String?
  logo            String?
  commissionRate  Float        @default(10.00)
  status          String       @default("PENDING")
  isVerified      Boolean      @default(false)
  isActive        Boolean      @default(true)
  verifiedAt      DateTime?
  reviewedBy      Int?
  rejectionReason String?
  rating          Float        @default(0)
  totalReviews    Int          @default(0)
  kycStatus       String       @default("NOT_SUBMITTED")
  kycSubmittedAt  DateTime?
  kycReviewedAt   DateTime?
  kycRejectionReason String?
  kycData         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  bookings        Booking[]
  flights         Flight[]
qrLogs          QrLog[]
  rooms           Room[]
  seatLocks       SeatLock[]
  user            User            @relation(fields: [userId], references: [id])
  services        Service[]
  settlements     Settlement[]
  payoutRequests  PayoutRequest[]

  @@map("service_providers")
}

model Service {
  id              Int                   @id @default(autoincrement())
  providerId      Int
  name            String
  category        String
  description     String?
  route           String?
  price           Float
  currency        String                @default("BDT")
  capacity        Int?
  availability    String?
  status          String                @default("ACTIVE")
  isActive        Boolean               @default(true)
  serviceType     String                @default("OTHER")
  lifecycleStatus String                @default("PUBLISHED")
  locationCity    String?
  locationAddress String?
  latitude        Float?
  longitude       Float?
  images          String?
  availableDays   String?
  startDate       DateTime?
  endDate         DateTime?
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  bookings        Booking[]
  availabilities  ServiceAvailability[]
  provider        ServiceProvider       @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([lifecycleStatus])
  @@index([serviceType])
  @@index([locationCity])
  @@map("services")
}

model SeatLock {
  id         Int             @id @default(autoincrement())
  providerId Int
  userId     Int
  category   String
  seatNumber String
  travelDate DateTime
  expiresAt  DateTime
  releasedAt DateTime?
  bookingId  Int?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, category, travelDate, seatNumber, releasedAt])
  @@index([expiresAt])
  @@map("seat_locks")
}

model ServiceAvailability {
  id        Int      @id @default(autoincrement())
  serviceId Int
  date      DateTime
  startTime String?
  endTime   String?
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, date])
  @@map("service_availabilities")
}

model Room {
  id             Int                 @id @default(autoincrement())
  providerId     Int
  name           String
  type           String
  description    String?
  price          Float
  capacity       Int                 @default(2)
  totalRooms     Int                 @default(1)
  amenities      String?
  images         String?
  isAvailable    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  bookings       Booking[]
  availabilities HotelAvailability[]
  provider       ServiceProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("rooms")
}

model HotelAvailability {
  id          Int      @id @default(autoincrement())
  roomId      Int
  date        DateTime
  totalRooms  Int
  bookedRooms Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([roomId, date])
  @@map("hotel_availabilities")
}

model Flight {
  id             Int             @id @default(autoincrement())
  providerId     Int
  flightNumber   String
  origin         String
  destination    String
  departureTime  DateTime
  arrivalTime    DateTime
  duration       Int?
  aircraftType   String?
  capacity       Int
  availableSeats Int
  price          Float
  currency       String          @default("BDT")
  status         String          @default("scheduled")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       Booking[]
  provider       ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([origin, destination])
  @@index([departureTime])
  @@index([status])
  @@map("flights")
}

model Booking {
  id              Int             @id @default(autoincrement())
  bookingCode     String          @unique @default(uuid())
  userId          Int
  providerId      Int
  serviceId       Int?
  flightId        Int?
  roomId          Int?
  category        String
  bookingDate     DateTime
  travelDate      DateTime
  returnDate      DateTime?
  numberOfPeople  Int             @default(1)
  totalAmount     Float
  discountAmount  Float           @default(0.00)
  finalAmount     Float
  status          String          @default("pending")
  paymentStatus   String          @default("pending")
  qrCode          String?
  qrToken         String?
  seatNumbers     String?
  passengerInfo   String?
  route           String?
  specialRequest  String?
  rejectionReason String?
  cancelledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  room            Room?           @relation(fields: [roomId], references: [id])
  flight          Flight?         @relation(fields: [flightId], references: [id])
  service         Service?        @relation(fields: [serviceId], references: [id])
  provider        ServiceProvider @relation(fields: [providerId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  payments        Payment[]
  qrLogs          QrLog[]
  review          Review?
  settlement      Settlement?

  @@index([userId])
  @@index([providerId])
  @@index([serviceId])
  @@index([flightId])
  @@index([roomId])
  @@index([status])
  @@map("bookings")
}

model QrLog {
  id            Int             @id @default(autoincrement())
  bookingId     Int
  userId        Int
  providerId    Int
  qrToken       String
  discountType  String
  discountValue Float
  scannedAt     DateTime        @default(now())
  isUsed        Boolean         @default(false)
  provider      ServiceProvider @relation(fields: [providerId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  booking       Booking         @relation(fields: [bookingId], references: [id])

  @@map("qr_logs")
}

model Payment {
  id              Int       @id @default(autoincrement())
  bookingId       Int
  amount          Float
  method          String
  transactionId   String    @unique
  status          String
  gatewayResponse String?
  paidAt          DateTime?
  refundedAt      DateTime?
  refundReason    String?
  createdAt       DateTime  @default(now())
  booking         Booking   @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("payments")
}

model Review {
  id        Int      @id @default(autoincrement())
  bookingId Int      @unique
  userId    Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}

model Settlement {
  id               Int             @id @default(autoincrement())
  providerId       Int
  bookingId        Int             @unique
  serviceId        Int?
  grossAmount      Float
  commissionRate   Float
  commissionAmount Float
  netAmount        Float
  currency         String          @default("BDT")
  status           String          @default("pending")
  paidAt           DateTime?
  settledAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  booking          Booking         @relation(fields: [bookingId], references: [id])
  provider         ServiceProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([status])
  @@index([serviceId])
  @@map("settlements")
}

model PayoutRequest {
  id              Int             @id @default(autoincrement())
  providerId      Int
  amount          Float
  currency        String          @default("BDT")
  method          String          @default("BANK")
  payoutDetails   String?
  status          String          @default("PAYOUT_REQUESTED")
  rejectionReason String?
  processedAt     DateTime?
  paidAt          DateTime?
  transactionRef  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now())
  provider        ServiceProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([status])
  @@map("payout_requests")
}

model SystemSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([key])
  @@map("system_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   Int?
  actorRole String?
  details   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
